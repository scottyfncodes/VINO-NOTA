# --- Required -------------------------------------------------------------
# PostgreSQL connection string. On Vercel use the pooled Neon URL.
DATABASE_URL=postgresql://vino:vino@localhost:5432/vinonota

# 32+ random characters; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of this deployment (optional on Vercel, which provides it).
BETTER_AUTH_URL=http://localhost:3000

# --- Photo storage ---------------------------------------------------------
# Private Vercel Blob store token. Without it, local development stores photos
# under ./.data/storage; on Vercel, photo upload is disabled with a clear message.
BLOB_READ_WRITE_TOKEN=

# --- Optional: label recognition -------------------------------------------
# Enables automatic label reading via Claude vision. Without it, Capture uses
# manual entry and says so. The key is only ever used server-side.
ANTHROPIC_API_KEY=
# RECOGNITION_MODEL=claude-opus-5-5
