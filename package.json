    "test:backup-blobs": "bash scripts/backup-blobs.test.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.10",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
